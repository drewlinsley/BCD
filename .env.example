# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Parallel.ai (discovery + sentinels) ---
PARALLEL_API_KEY=

# --- GitHub (push / PR automation) ---
GITHUB_TOKEN=

# --- Postgres (set either var to use the Postgres store; unset both = SQLite dev store) ---
# BCD_STORE_BACKEND=postgres    # force a backend explicitly: sqlite | postgres
BCD_DATABASE_URL=postgresql+psycopg://localhost:5432/bcd   # the +psycopg suffix is stripped for psycopg3
# Requires the `vector` and `pg_trgm` extensions on the target db:
#   CREATE EXTENSION IF NOT EXISTS vector;  CREATE EXTENSION IF NOT EXISTS pg_trgm;

# --- Redis (arq job queue) ---
BCD_REDIS_URL=redis://localhost:6379/0

# --- Object store (raw HTML / label images). Local dir in dev; R2/S3 in prod ---
BCD_BLOB_BACKEND=local
BCD_BLOB_ROOT=./data/raw

# --- Cloud LLM for enrichment + cold-path resolve (server-side only) ---
ANTHROPIC_API_KEY=
BCD_ENRICH_MODEL=claude-sonnet-5

# --- Crawler identity (honesty about who is fetching) ---
BCD_CRAWLER_UA=BCDBot/0.1 (+https://github.com/drewlinsley/BCD; contact set in .env)
BCD_CRAWLER_CONTACT=
