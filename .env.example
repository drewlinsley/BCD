# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Parallel.ai (discovery + sentinels) ---
PARALLEL_API_KEY=

# --- GitHub (push / PR automation) ---
GITHUB_TOKEN=

# --- Postgres (set either var to use the Postgres store; unset both = SQLite dev store) ---
# BCD_STORE_BACKEND=postgres    # force a backend explicitly: sqlite | postgres
BCD_DATABASE_URL=postgresql+psycopg://localhost:5432/bcd   # the +psycopg suffix is stripped for psycopg3
# Requires the `vector` and `pg_trgm` extensions on the target db:
#   CREATE EXTENSION IF NOT EXISTS vector;  CREATE EXTENSION IF NOT EXISTS pg_trgm;

# --- Redis (arq job queue) ---
BCD_REDIS_URL=redis://localhost:6379/0

# --- Object store (raw HTML / label images). Local dir in dev; R2/S3 in prod ---
BCD_BLOB_BACKEND=local
BCD_BLOB_ROOT=./data/raw

# --- Reading a label off the picture (/v1/scan/vision) ---
# Which model reads the frame: "anthropic" (hosted, needs the key below) or "ollama" (a model
# running on this machine — no key, no per-call cost, and no GPU acceleration on an Intel Mac).
# Unset means: the hosted one if there is a key, otherwise nothing, and the endpoint says so.
BCD_VISION_PROVIDER=
# Optional. Defaults to claude-opus-5 hosted (claude-sonnet-5 is ~3x cheaper if it reads labels
# as well), or qwen2.5vl:3b locally.
BCD_VISION_MODEL=
BCD_OLLAMA_URL=

# --- Cloud LLM for enrichment and cold-path resolve ---
# Also the key the hosted vision provider uses. The API reads this file at startup; a real
# environment variable still wins.
ANTHROPIC_API_KEY=
BCD_ENRICH_MODEL=claude-sonnet-5

# --- Crawler identity (honesty about who is fetching) ---
BCD_CRAWLER_UA=BCDBot/0.1 (+https://github.com/drewlinsley/BCD; contact set in .env)
BCD_CRAWLER_CONTACT=
