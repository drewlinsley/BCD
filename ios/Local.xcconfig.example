// Template for ios/Local.xcconfig (which is gitignored). Copy and fill in:
//   cp Local.xcconfig.example Local.xcconfig
// `make ios-gen` does this copy automatically when Local.xcconfig is missing.

// Apple Developer Team ID — required to run on a physical device; blank builds for the
// Simulator. Xcode ▸ Settings ▸ Accounts ▸ your team (the 10-char ID), or the Apple
// Developer portal ▸ Membership. A free Apple ID's personal team works.
DEVELOPMENT_TEAM =

// App bundle identifier — must be globally unique for a free Apple ID (a personal team
// can't register a generic id like com.bcd.app). Use your own reverse-DNS, e.g. com.you.bcd.
BCD_BUNDLE_ID = com.example.bcd

// API base, split into scheme + host:port because "//" starts a comment in an xcconfig.
// The Simulator can use localhost; a real device needs this Mac's LAN IP on the same
// Wi-Fi, e.g. BCD_API_HOSTPORT = 192.168.1.50:8000.
BCD_API_SCHEME = http
BCD_API_HOSTPORT = localhost:8000

// On-device scan pipeline. `visionkit` = DataScannerViewController (text + barcode, the
// known-good path). `vision` = AVCapture + Vision: segments cans/bottles, OCR without
// language correction, catalog lexicon as custom words — the coarse-to-fine pipeline in
// full. Try `vision` on a device once `visionkit` is confirmed working.
BCD_SCAN_ENGINE = visionkit

// Sign in with Google. Create an OAuth 2.0 Client ID of type iOS at
// console.cloud.google.com -> APIs & Services -> Credentials, using this build's bundle id.
// There is NO client secret: a native app cannot keep one, which is why the flow is PKCE.
// Leave both blank and the Google button is simply not offered -- never offered and broken.
//
// The reversed id is the same string with its dot-separated parts in reverse order; Google
// shows it on the credential page as the "iOS URL scheme".
//   BCD_GOOGLE_CLIENT_ID          = 1234567890-abcdef.apps.googleusercontent.com
//   BCD_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdef
BCD_GOOGLE_CLIENT_ID =
BCD_GOOGLE_REVERSED_CLIENT_ID =
